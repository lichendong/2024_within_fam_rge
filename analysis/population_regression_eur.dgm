VERSION 1.1.0
INPUT
TITLE:

        Causal rGE on differential parenting;

DATA:
        FILE IS "c:\Repo\data_local\populationrGE_addh_missfix.csv";
VARIABLE:
        Names are AID FAM GPAIRID GID GFAM
        pgs ANCESTRY SCID sex age_1 age_3
        white african native asian other hispanic
        income par_ed par_age
        par_sex par_marry
        bad_temper pr_parent pr_child del_peer scho_con
        asb_1 asb_3 sub_1 sub_3
        par_sub autonomy par_involv adhd;
        usevariables are
         pgs sex age_1
         pr_parent pr_child del_peer scho_con
         asb_1 sub_1 asb_3 sub_3
         income par_ed
         ;
        useobs are ANCESTRY EQ 1;
        Missing are .;
DEFINE:
        income = log(income + 1);
ANALYSIS:
        ESTIMATOR = BAYES;
        PROC = 10;
        CHAINS = 10;
        FBITERATIONS= 15000;
OUTPUT:
 TECH1 TECH8 CINTERVAL;
PLOT:
 TYPE = PLOT2;
MODEL:
        pr_parent ON pgs sex age_1 income par_ed ;
        pr_child ON pgs sex age_1 income par_ed ;
        del_peer ON pgs sex age_1 income par_ed ;
        scho_con ON pgs sex age_1 income par_ed ;
        asb_1 sub_1 asb_3 sub_3 ON pgs sex age_1 income par_ed ;
        pgs sex age_1 income par_ed ;
        pgs sex WITH pgs sex age_1 income par_ed ;
        age_1 income WITH pgs sex age_1 income par_ed ;
        par_ed WITH pgs sex age_1 income par_ed ;
INPUT_END
